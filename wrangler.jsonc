{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-tao-trac-nghiem",
  "main": "worker.js",
  "compatibility_date": "2026-05-25",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": ["GEMINI_API_KEY", "CF_AIG_TOKEN"]
  },
  "vars": {
    "CF_AIG_ACCOUNT_ID": "9cfdacf13184881724759ce98fa45d5a",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite"
  },

  "kv_namespaces": [
    { "binding": "SHARES", "id": "4eba8ce34e9b4c8992e8fb7cf7d247e5" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "US_PROXY", "class_name": "USProxy" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["USProxy"] }
  ],
  "ratelimits": [
    {
      "name": "CONVERT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
