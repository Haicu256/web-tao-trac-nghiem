{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-tao-trac-nghiem",
  "main": "worker.js",
  "compatibility_date": "2026-05-25",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  // Lưu đề được chia sẻ. Không có "id" -> wrangler tự tạo KV khi deploy (beta, cần wrangler >= 4.45.0).
  // Nếu deploy báo lỗi: tạo KV thủ công rồi thêm "id": "<ID của namespace>" vào đây.
  "kv_namespaces": [
    { "binding": "SHARES" }
  ],
  "ratelimits": [
    {
      "name": "CONVERT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
